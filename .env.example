# Gemini API キー。未設定の場合は内蔵のフォールバック生成器で動作します。
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 任意設定（未設定時は server/config.ts のデフォルト値を使用）
# PORT=3000
# GEMINI_MODEL="gemini-3.8-flash"

# DB（Phase 1〜）。ローカルは docker compose の db。本番の値は docs/supabase-setup.md を参照
# DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:54322/postgres"

# --- 認証・セッション（Phase 3〜）---
# バックエンドの DB 接続（ローカルは docker compose の db。本番は docs/supabase-setup.md の DATABASE_URL）
DATABASE_URL="postgresql://idea_ws_app:idea_ws_app@localhost:54322/postgres"
# トークン・IP をハッシュ化する鍵。本番は十分に長いランダム文字列（例: python -c "import secrets; print(secrets.token_urlsafe(48))"）
SESSION_TOKEN_PEPPER="local-dev-pepper-change-me"
# 状態を変えるリクエストを許可する Origin（カンマ区切り）
ALLOWED_ORIGINS="http://localhost:3000"
# ローカルは http なので false。本番は true（Cookie 名が __Host-iws_session になる）
COOKIE_SECURE=false
# Vercel 上では true
TRUST_PROXY_HEADERS=false
# Cloudflare Turnstile。以下はローカル用の公式テストキー（常に成功する）
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# --- アカウント（Phase 5〜）---
# Vercel Cron が Authorization: Bearer で送る秘密（16 文字以上のランダム文字列）
CRON_SECRET="local-dev-cron-secret-change-me"

# --- モック（一時的）---
# DB に接続せず固定のサンプルを返す（保存は 503）。Supabase を用意するまでの Vercel 動作確認用。
# 未設定なら、Vercel 上（VERCEL_ENV あり）で DATABASE_URL が無いとき自動でモックになる。true / false で固定する
# MOCK_BACKEND=false

# --- docker compose（ローカルのみ）---
# ホスト側のポート。ほかのアプリとぶつかる場合だけ変える（コンテナ内の接続先は docker-compose.yml で固定）
# DB_PORT=54322
# DB_TEST_PORT=54323
# API_PORT=8000
# WEB_PORT=3000
