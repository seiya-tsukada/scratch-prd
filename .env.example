# Gemini API キー。未設定の場合は内蔵のフォールバック生成器で動作します。
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 任意設定（未設定時は server/config.ts のデフォルト値を使用）
# PORT=3000
# GEMINI_MODEL="gemini-3.8-flash"

# DB（Phase 1〜）。ローカルは docker compose の db。本番の値は docs/supabase-setup.md を参照
# DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:54322/postgres"
